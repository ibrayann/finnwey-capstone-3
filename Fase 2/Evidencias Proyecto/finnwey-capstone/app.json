{
  "expo": {
    "name": "finnwey",
    "slug": "finnwey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permitir el uso de Face ID para un acceso rápido y seguro a tu cuenta",
        "NSCameraUsageDescription": "La aplicación necesita acceso a la cámara para escanear documentos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir el uso de Face ID para un acceso rápido y seguro a tu cuenta"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://vvzmlchzfurkpvkefyrg.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ2em1sY2h6ZnVya3B2a2VmeXJnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTg4Mjg2OTUsImV4cCI6MjA3NDQwNDY5NX0.-nTz1S_gfkKKPHcgaAuC7lVFhxCASGNIXIZzRYVM__o"
    }
  }
}